# TMDB API key for fetching movie/show metadata
VITE_TMDB_READ_API_KEY=...

# Enable/disable febbox (FED API) VIP streaming
VITE_ALLOW_FEBBOX_KEY=true

# URL of the febbox / FED API backend (hosted on Cloudflare Workers)
VITE_FEBBOX_API_URL=https://pstream-backend.deezgames.workers.dev

# Backend URL for user accounts, bookmarks, progress, etc.
VITE_BACKEND_URL=...

# CORS proxy URL(s). Comma-separated for multiple. No trailing slash.
VITE_CORS_PROXY_URL=...

# Google Analytics measurement ID
VITE_GA_ID=...

# Cloudflare Turnstile site key (for registration captcha)
VITE_TURNSTILE_KEY=...

# DMCA contact email shown in the footer
VITE_DMCA_EMAIL=...

# Show onboarding flow for new users
VITE_HAS_ONBOARDING=false

# Allow autoplay without extension/proxy
VITE_ALLOW_AUTOPLAY=false

# Use normal (non-hash) router
VITE_NORMAL_ROUTER=false

# Show ad banner on homepage
VITE_SHOW_AD=false

# Ad content URLs (comma-separated)
VITE_AD_CONTENT_URL=...

# CDN URL replacements (format: before:after,before:after)
VITE_CDN_REPLACEMENTS=...

# Comma-separated list of media IDs to disallow (format: movie-123,show-456)
VITE_DISALLOWED_IDS=...

# Analytics/tracking script URL
VITE_TRACK_SCRIPT=...

# Extension install links for onboarding
VITE_ONBOARDING_CHROME_EXTENSION_INSTALL_LINK=...
VITE_ONBOARDING_FIREFOX_EXTENSION_INSTALL_LINK=...
VITE_ONBOARDING_PROXY_INSTALL_LINK=...
